    <script is:inline>
      (function () {
        var root = document.documentElement;
        var rail = document.querySelector('.progress');
        var fill = rail.querySelector('.fill');
        var sections = Array.prototype.slice.call(document.querySelectorAll('main > section, footer.band'));
        var ticks = [];
        var raf = 0;

        function build() {
          ticks.forEach(function (t) { t.el.remove(); });
          ticks = [];
          var max = Math.max(1, root.scrollHeight - window.innerHeight);
          sections.forEach(function (sec) {
            var pos = Math.min(1, Math.max(0, sec.offsetTop / max));
            var el = document.createElement('i');
            el.className = 'tick';
            el.style.top = pos * 100 + '%';
            rail.appendChild(el);
            ticks.push({ el: el, pos: pos });
          });
          update();
        }

        var where = document.querySelector('.where');
        var labels = [['work', 'Selected work'], ['experience', 'Experience'], ['skills', 'Skills'], ['contact', 'Contact']];

        function currentLabel() {
          var y = window.scrollY + window.innerHeight * 0.4;
          var cur = '';
          labels.forEach(function (pair) {
            var el = document.getElementById(pair[0]);
            if (el && el.offsetTop <= y) cur = pair[1];
          });
          if (where.textContent !== cur) {
            where.textContent = cur;
          }
        }

        function update() {
          raf = 0;
          currentLabel();
          var max = Math.max(1, root.scrollHeight - window.innerHeight);
          var p = Math.min(1, Math.max(0, window.scrollY / max));
          fill.style.transform = 'scaleY(' + p + ')';
          ticks.forEach(function (t) { t.el.classList.toggle('on', p >= t.pos - 0.002); });
        }

        function onScroll() { if (!raf) raf = requestAnimationFrame(update); }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', build);
        window.addEventListener('load', build);
        build();

        var themeBtn = document.querySelector('.theme');
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        function paintTheme() {
          var evening = root.dataset.theme === 'evening';
          themeBtn.textContent = evening ? 'Day' : 'Evening';
          themeBtn.setAttribute('aria-label', evening ? 'Switch to day mode' : 'Switch to evening mode');
          if (themeMeta) themeMeta.setAttribute('content', evening ? '#0e1814' : '#eceeea');
        }
        themeBtn.addEventListener('click', function () {
          root.dataset.theme = root.dataset.theme === 'evening' ? 'day' : 'evening';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
          paintTheme();
        });
        paintTheme();

        document.querySelectorAll('.copy').forEach(function (b) {
          if (!navigator.clipboard) { b.hidden = true; return; }
          b.addEventListener('click', function () {
            navigator.clipboard.writeText(b.dataset.copy).then(function () {
              var label = 'Copy';
              b.textContent = 'Copied';
              setTimeout(function () { b.textContent = label; }, 1600);
            });
          });
        });

        var marks = document.querySelectorAll('.prose em, .prose strong, .convictions em, .lede em');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('drawn'); io.unobserve(e.target); }
            });
          }, { threshold: 0.9 });
          marks.forEach(function (m) { io.observe(m); });
        } else {
          marks.forEach(function (m) { m.classList.add('drawn'); });
        }
      })();
    </script>
  </body>
</html>
