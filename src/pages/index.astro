import '../styles/global.css';

const email = 'adarshask07@gmail.com';
const phone = '+91 7385873567';
const linkedin = 'https://www.linkedin.com/in/adarsh-satpute-0425a72a1';
const github = 'https://github.com/adarshask07';

const certs = [
  { lines: ['Claude', 'Certified', 'Architect'], issuer: 'Anthropic', note: 'Anthropic' },
  { lines: ['Google Cloud', 'Digital Leader'], issuer: 'Google Cloud', note: 'Google Cloud · Jan 2025' },
  { lines: ['AB-731 Azure AI', 'Transformation', 'Leader'], issuer: 'Microsoft', note: 'Microsoft' },
