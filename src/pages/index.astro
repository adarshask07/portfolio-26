                    <svg viewBox="0 0 160 160" role="img" aria-label={`${c.lines.join(' ')}, ${c.note}`}>
                      <circle class="outer" cx="80" cy="80" r="77" />
                      <circle class="inner" cx="80" cy="80" r="71" />
                      <path id={`ring-${i}`} d="M 18 80 a 62 62 0 1 1 124 0 a 62 62 0 1 1 -124 0" fill="none" />
                      <text class="ring" aria-hidden="true">
