    <meta
      property="og:description"
      content="I design and build enterprise agentic AI systems end to end."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        var t;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'day' && t !== 'evening') {
          t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'evening' : 'day';
        }
        r.dataset.theme = t;
      })();
